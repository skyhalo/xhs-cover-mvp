PORT=5177

# 用于“原始标题/正文 -> 50 条标题/花字”的文本模型 key
OPENAI_TEXT_API_KEY=your_text_model_key_here
OPENAI_TEXT_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4.1-mini

# 用于“原图 -> 带花字封面”的 RunningHub 图片编辑 key
RUNNINGHUB_IMAGE_API_KEY=your_runninghub_key_here
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
RUNNINGHUB_IMAGE_ENDPOINT=/openapi/v2/rhart-image-g-2/image-to-image
RUNNINGHUB_QUERY_ENDPOINT=/openapi/v2/query
RUNNINGHUB_UPLOAD_ENDPOINT=/openapi/v2/media/upload/binary
RUNNINGHUB_TASK_TIMEOUT_MS=720000
RUNNINGHUB_POLL_INTERVAL_MS=3000

# 可选：如果不用 RunningHub，也可以填 OpenAI 图片 key
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# 可选：兼容旧配置。如果上面两个 key 没填，会回退到这个 key。
OPENAI_API_KEY=
